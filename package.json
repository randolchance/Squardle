{
  "name": "squaredle",
  "version": "1.0.0",
  "private": true,
  "description": "5x5 crossword using only valid Wordle words",
  "keywords": [
    "crossword",
    "wordle"
  ],
  "license": "ISC",
  "author": "Dco Codes",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "host-dev": "fastapi dev main.py",
    "dev": "npm-run-all --parallel dev:*",
    "dev:onchange": "onchange -k \"*.html\" \"src/**/*.js\" \"src/**/*.vue\" -- npm run dev:build",
    "dev:build": "vite build && npm run host-dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "~10.2.0",
    "globals": "^16.2.0",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^7.7.7"
  }
}
